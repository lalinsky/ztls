    "TLS13-EmptyRecords-TLS": "a record with no content type is decode_error here, not bad_record_mac",
    "CheckRecordVersion-TLS13": "RFC 9846 5.1 says the record version must be ignored",
    "GarbageInitialRecordVersion-TLS13": "RFC 9846 5.1 says the record version must be ignored",
    "*VerifyDefault-ECDSA_P521*": "P-521 signatures are accepted here",
    "*VerifyDefault-Ed25519*": "Ed25519 is accepted by default here",
    "Ed25519DefaultDisable*": "Ed25519 is accepted by default here",
    "*CertificateType*": "no raw public keys",
    "TLS13-HRR-InvalidCompressionMethod": "RFC 9846 4.2.3 says illegal_parameter, BoringSSL says decode_error",
